[user]
	name = Ashu463
	email = ashukasaudhan971@gmail.com
	signingkey = /home/ashuk/.ssh/id_ed25519.pub
[http]
	postBuffer = 524288000
	cookiefile = /home/ashuk/.gitcookies
	version = HTTP/1.1
	lowSpeedLimit = 0
	lowSpeedTime = 999999
[https]
	postBuffer = 1048576000
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = /home/ashuk/.ssh/allowed_signers
[credential]
	helper = store
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
