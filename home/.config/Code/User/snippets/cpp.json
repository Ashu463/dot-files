			"using namespace std;",
			"",
			"struct Node{",
			"int val;",
			"Node* left;",
			"Node* right;",

			"Node(int x){",
			"this -> val = x;",
			"left = nullptr;",
			"right = nullptr;",
			"}",
			"Node(int x, Node* left, Node* right){",
				"this -> val = x;",
				"this -> left = left;",
				"this -> right = right ;",
			"}",
			"};",
			"",
